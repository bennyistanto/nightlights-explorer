{
  "name": "nightlights-explorer",
  "private": true,
  "type": "module",
  "description": "Nightlights Explorer: Indonesia after dark, by province, district and sub-district. Static dashboard built with Observable Framework.",
  "scripts": {
    "dev": "observable preview",
    "build": "observable build",
    "serve": "python -m http.server 3212 --directory dist --bind 127.0.0.1",
    "clean": "rimraf site/.observablehq/cache dist",
    "deploy": "pwsh -NoProfile -File tools/deploy.ps1",
    "deploy:check": "pwsh -NoProfile -File tools/deploy.ps1 -DryRun"
  },
  "dependencies": {
    "@observablehq/framework": "^1.13.4"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
